# ==============================================================================
# Streamlit Community Cloud 雲端部署 Secrets 設定範本 (.streamlit/secrets.toml.example)
# 使用方式：
# 1. 登入 https://share.streamlit.io 部署本專案 (Main file path 填寫 `app.py`)
# 2. 點擊 App 右下角 Manage App -> Settings -> Secrets
# 3. 複製以下內容貼入並填入您的真實金鑰（未填入時系統仍可透過左側邊欄 BYOK 動態注入）
# ==============================================================================

GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-2.5-flash"

SUPABASE_URL = ""
SUPABASE_KEY = ""

NOTIFICATION_WEBHOOK_URL = ""
WORKSPACE_PASSCODE = ""
