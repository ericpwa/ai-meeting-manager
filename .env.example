# ==============================================================================
# AI 會議記錄管理 Web App - 環境變數設定範本 (.env.example)
# 資安鐵律：請複製本檔案為 `.env` 並填入真實金鑰，切勿將 `.env` 提交至 Git 版本庫！
# 若未設定 `.env` 或 `st.secrets`，系統將於左側邊欄提供 BYOK (Bring Your Own Key) 動態密碼輸入框。
# ==============================================================================

# 1. Google Gemini API 設定 (支援 Gemini 2.5 Flash 結構化輸出與音訊多模態轉譯)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Supabase 資料庫設定 (選填：未設定時系統自動降級至本地 SQLite 雙模引擎，確保零成本開箱即用)
SUPABASE_URL=
SUPABASE_KEY=

# 3. 跨部門催辦通知 Webhook URL (選填：支援 Slack / Teams / Discord Webhook，未設定時採安全模擬推播)
NOTIFICATION_WEBHOOK_URL=

# 4. 企業內部工作區選用通行碼 (選填：留空代表內部共享直接進入；設定後需輸入通行碼解鎖工作區)
WORKSPACE_PASSCODE=

# 5. 本地備援資料庫路徑 (預設自動建立於 data/local_meetings.db)
LOCAL_DB_PATH=data/local_meetings.db
